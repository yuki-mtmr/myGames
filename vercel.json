{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd shooting && npm install && npm run build && cd ../shogi && npm install && npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/shooting/(.*)", "destination": "/shooting/dist/$1" },
    { "source": "/shooting", "destination": "/shooting/dist/index.html" },
    { "source": "/shogi/(.*)", "destination": "/shogi/dist/$1" },
    { "source": "/shogi", "destination": "/shogi/dist/index.html" },
    { "source": "/", "destination": "/shooting/dist/index.html" }
  ],
  "headers": [
    {
      "source": "/shogi/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
